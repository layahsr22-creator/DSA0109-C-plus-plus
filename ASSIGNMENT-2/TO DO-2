#include <cstdint>
#include <iostream>
#include <vector>

int& highest(std::vector<int>& v)
{
    std::size_t idx = 0;
    for (std::size_t i = 1; i < v.size(); ++i)
        if (v[i] > v[idx]) idx = i;
    return v[idx];
}

std::size_t highestIndex(const std::vector<int>& v)
{
    std::size_t idx = 0;
    for (std::size_t i = 1; i < v.size(); ++i)
        if (v[i] > v[idx]) idx = i;
    return idx;
}

int main()
{
    std::vector<int> v = {72, 88, 65, 91, 79};
    std::cout << "size=" << v.size() << " capacity=" << v.capacity() << '\n';

    std::uintptr_t refAddr = reinterpret_cast<std::uintptr_t>(&highest(v));
    std::size_t idx = highestIndex(v);
    const int* oldData = v.data();

    for (int i = 0; i < 20; ++i) v.push_back(50);   // vector grows -> reallocates

    std::cout << "buffer moved: " << std::boolalpha << (v.data() != oldData) << '\n';
    std::cout << "old reference still points into live buffer: "
              << (refAddr == reinterpret_cast<std::uintptr_t>(&v[idx])) << '\n';

    v[idx] += 2;                                    // index is still valid
    std::cout << "v[idx] after +=2 via index: " << v[idx] << '\n';
}
